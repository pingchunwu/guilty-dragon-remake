{
  "name": "guilty-dragon-remake",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "supabase"
  ],
  "scripts": {
    "dev": "npm run dev -w @gdr/web",
    "build": "npm run build -w @gdr/engine && npm run build -w @gdr/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gen:seed": "npm run gen:seed -w @gdr/supabase",
    "gen:engine": "npm run gen:engine -w @gdr/supabase"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
